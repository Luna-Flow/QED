msgid "Current support matrix"
msgstr ""

#: manual/manual.md:577
msgid "Shipped now"
msgstr ""

#: manual/manual.md:579
msgid "checked kernel + scoped signature + gate discipline"
msgstr ""

#: manual/manual.md:580
msgid "resolved elaboration boundary"
msgstr ""

#: manual/manual.md:581
msgid "parser normalize/raw-offset/theorem-script raw parsing, including sequential block bodies, structured branch blocks, theorem-header binders, the hole step, and raw binder/goal/step spans"
msgstr "parser normalize/raw-offset/theorem-script raw parsing, including sequential block bodies、structured branch blocks、theorem-header binders、hole step，以及 raw binder/goal/step spans"

