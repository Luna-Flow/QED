msgstr "已提升的 rewrite/simplify 策略 (tactic) 或命令界面"

#: manual/manual.md:600
msgid "kernel metavariables / hole completion authority"
msgstr "内核元变量 / hole 补全权限"

#: manual/manual.md:601
msgid "dictionary passing / typeclass frontend"
msgstr "字典传递 / 类型类前端"

#: manual/manual.md:602
msgid "arbitrary theorem-environment references"
msgstr "任意的定理环境引用"

#: manual/manual.md:603
