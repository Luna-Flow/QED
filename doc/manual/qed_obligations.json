  "status_definitions": {
    "proved-and-refined": "The mathematical obligation is proved and a checked refinement connects the implementation to it.",
    "proved-abstractly": "The mathematical obligation is proved in Lean, but implementation refinement is absent.",
    "tested-only": "Executable tests cover the behavior without a corresponding mechanized proof.",
    "implemented-unverified": "The implementation exposes the behavior, but evidence is incomplete or not yet audited.",
    "partial": "Only a stated fragment of the obligation is covered.",
    "not-implemented": "The required behavior is absent.",
    "known-deviation": "The implementation or formalization intentionally differs from the normative contract and the difference is recorded.",
    "not-applicable": "The obligation is outside the supported QED calculus."
  },
